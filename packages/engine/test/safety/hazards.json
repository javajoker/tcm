      "ref": "safety policy §6, N-TIERC",
      "input": {
        "interview": "EX1"
      },
      "expect": {
        "release": {
          "level": "L1",
          "noFormulas": true,
          "hide": [
            "F_MAHUANG"
          ]
        },
        "dev": {
          "level": "L3",
          "show": [
            "F_MAHUANG"
          ],
          "annotated": {
            "F_MAHUANG": [
              "R_STRONG_HERB"
            ]
          }
        }
      }
    },
    {
