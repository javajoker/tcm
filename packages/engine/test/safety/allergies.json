            ]
          }
        }
      }
    },
    {
      "id": "ALG-MIXED-HANS",
      "title": "a Simplified entry that matches acts, and one that matches nothing is still reported",
      "ref": "safety policy §2.2 (PM-33)",
      "input": {
        "interview": "SP1",
        "subject": {
          "allergies": [
            "人参",
