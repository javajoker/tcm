{
  "_comment": "Each pregnancy-restricted acupoint (data/safety/rules.json) and each food with a pregnancy caution (data/treatment/guidance.json), given straight to the safety filter for a pregnant woman.",
  "vignettes": [
    {
      "id": "PREG-POINT-合谷",
      "title": "合谷 in pregnancy: never offered in release (L0); dev keeps it with the pregnancy warning",
      "ref": "data/safety/rules.json R_PREG_ACUPOINTS",
      "kind": "candidates",
      "input": {
        "subject": {
          "pregnant": true
        },
        "candidates": [
          {
            "kind": "acupoint",
            "name": "合谷"
          }
        ]
      },
      "expect": {
        "release": {
          "level": "L0",
          "noAcupoints": true,
          "suppressed": [
            {
              "kind": "acupoint",
              "id": "合谷",
              "reason": "level"
            }
          ]
        },
        "dev": {
          "level": "L3",
          "show": [
            "合谷"
          ],
          "annotated": {
            "合谷": [
              "R_PREG_ACUPOINTS"
            ]
          }
        }
      }
    },
