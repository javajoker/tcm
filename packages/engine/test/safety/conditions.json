{
  "_comment": "The conditions of safety policy §2.1 (red flags are in red-flags.json) and the combinations named in test plan §3.3. Formulas of 脾氣虛 (四君子湯, 參苓白朮散) are the probe: both contain herbs tagged for the anticoagulant, hypoglycaemic, blood-pressure, potassium and immune interactions in data/herbs.",
  "vignettes": [
    {
      "id": "COND-SERIOUS",
      "title": "a serious chronic disease: blocking notice, L0 in release; in dev the formulas are annotated, not removed",
      "ref": "safety policy §2.1",
      "input": {
        "interview": "SP1",
        "subject": {
          "seriousChronicDisease": true
        }
      },
      "expect": {
        "release": {
          "level": "L0",
          "notice": "blocking_ack",
          "notices": [
            "N-SERIOUS"
          ],
          "emergencyResources": false,
          "noFormulas": true,
          "noFoods": true,
          "noAcupoints": true
        },
        "dev": {
          "level": "L3",
          "notices": [
            "N-SERIOUS"
          ],
          "annotated": {
            "F_SHENLING": [
              "R_SERIOUS_CHRONIC"
            ],
            "F_SIJUNZI": [
              "R_SERIOUS_CHRONIC"
            ]
          }
        }
      }
    },
