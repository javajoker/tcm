{
  "name": "@tcm/web",
  "version": "0.1.0",
  "private": true,
  "description": "The TCM self-assessment web app: a client-only static SPA (tech spec \u00a78).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "APP_PROFILE=dev vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build:e2e": "APP_DRAFT_LABEL=on vite build && APP_PROFILE=dev vite build --outDir dist-dev --emptyOutDir",
    "test:e2e": "pnpm build:e2e && playwright test",
    "e2e:visual": "pnpm build:e2e && playwright test --project=visual-320 --project=visual-1280"
  },
  "dependencies": {
    "@tcm/engine": "workspace:*",
    "@tcm/i18n": "workspace:*",
    "@tcm/kb": "workspace:*",
    "@tcm/wuxing": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
