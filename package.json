{
  "name": "tcm-app",
  "private": true,
  "type": "module",
  "description": "TCM self-assessment app — workspace root (see docs/tech-spec.md §2.1).",
  "packageManager": "pnpm@11.0.5",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
