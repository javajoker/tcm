    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build:kb": ".venv/bin/python -m scripts.kb.build_kb"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
