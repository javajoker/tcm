{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "enStatus": {
      "enum": [
        "machine-draft",
        "reviewed"
      ]
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "moduleId": {
      "enum": [
        "sleep",
        "fatigue",
        "digestion",
        "cold-heat-sweat",
        "head-body-pain",
        "mood-stress",
        "womens-cycle",
        "early-external"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "questionId": {
      "pattern": "^Q_[A-Z_]+$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "count": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "schema": {
          "type": "integer"
        }
      },
      "required": [
        "count",
        "description",
        "schema"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "alt": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "domain": {
            "type": "string"
          },
          "en": {
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "note": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "pinyin": {
            "type": "string"
          },
          "source": {
            "enum": [
              "who-istm-2007",
              "textbook",
              "project"
            ]
          },
          "status": {
            "enum": [
              "needs-review",
              "reviewed"
            ]
          },
          "zh-Hant": {
            "type": "string"
          }
        },
        "required": [
          "alt",
          "domain",
          "en",
          "id",
          "note",
          "pinyin",
          "source",
          "status",
          "zh-Hant"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "_meta",
    "items"
  ],
  "title": "Glossary",
  "type": "object"
}
