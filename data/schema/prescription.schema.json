{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "enStatus": {
      "enum": [
        "machine-draft",
        "reviewed"
      ]
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "moduleId": {
      "enum": [
        "sleep",
        "fatigue",
        "digestion",
        "cold-heat-sweat",
        "head-body-pain",
        "mood-stress",
        "womens-cycle",
        "early-external"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|yingwei\\.(衛|營|開闔)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "questionId": {
      "pattern": "^Q_[A-Z_]+$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "type": "string"
        },
        "design": {
          "type": "string"
        },
        "schema": {
          "type": "integer"
        }
      },
      "required": [
        "description",
        "design",
        "schema"
      ],
      "type": "object"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "bands": {
          "additionalProperties": false,
          "properties": {
            "large_above": {
              "type": "number"
            },
            "small_below": {
              "type": "number"
            }
          },
          "required": [
            "large_above",
            "small_below"
          ],
          "type": "object"
        },
        "dose": {
          "additionalProperties": false,
          "properties": {
            "gamma": {
              "type": "number"
            },
            "kappa": {
              "type": "number"
            },
            "reference": {
              "type": "string"
            }
          },
          "required": [
            "gamma",
            "kappa",
            "reference"
          ],
          "type": "object"
        },
        "mechanism": {
          "additionalProperties": false,
          "properties": {
            "theta": {
              "type": "number"
            },
            "top": {
              "type": "integer"
            }
          },
          "required": [
            "theta",
            "top"
          ],
          "type": "object"
        },
        "pairs": {
          "additionalProperties": false,
          "properties": {
            "sigma": {
              "type": "number"
            },
            "tau": {
              "type": "number"
            }
          },
          "required": [
            "sigma",
            "tau"
          ],
          "type": "object"
        },
        "roles": {
          "additionalProperties": false,
          "properties": {
            "carrier_min": {
              "type": "number"
            },
            "fanzuo_below": {
              "type": "number"
            }
          },
          "required": [
            "carrier_min",
            "fanzuo_below"
          ],
          "type": "object"
        },
        "verification": {
          "additionalProperties": false,
          "properties": {
            "burden_ratio_max": {
              "type": "number"
            },
            "cosine_min": {
              "type": "number"
            },
            "flat_below": {
              "type": "number"
            },
            "rank_max": {
              "type": "integer"
            }
          },
          "required": [
            "burden_ratio_max",
            "cosine_min",
            "flat_below",
            "rank_max"
          ],
          "type": "object"
        }
      },
      "required": [
        "bands",
        "dose",
        "mechanism",
        "pairs",
        "roles",
        "verification"
      ],
      "type": "object"
    }
  },
  "required": [
    "_meta",
    "params"
  ],
  "title": "Parameters of the prescription model",
  "type": "object"
}
