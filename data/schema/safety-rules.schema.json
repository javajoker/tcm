{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "enStatus": {
      "enum": [
        "machine-draft",
        "reviewed"
      ]
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "moduleId": {
      "enum": [
        "sleep",
        "fatigue",
        "digestion",
        "cold-heat-sweat",
        "head-body-pain",
        "mood-stress",
        "womens-cycle",
        "early-external"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|yingwei\\.(衛|營|開闔)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "questionId": {
      "pattern": "^Q_[A-Z_]+$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "clinical_review_required": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "count": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "schema": {
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        }
      },
      "required": [
        "clinical_review_required",
        "count",
        "description",
        "schema",
        "status"
      ],
      "type": "object"
    },
    "dose_references": {
      "additionalProperties": false,
      "properties": {
        "elderly": {
          "type": "string"
        },
        "minor_fractions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "age": {
                "type": "string"
              },
              "fraction_of_adult": {
                "type": "string"
              }
            },
            "required": [
              "age",
              "fraction_of_adult"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "elderly",
        "minor_fractions",
        "note"
      ],
      "type": "object"
    },
    "incompatibilities": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "$ref": "#/$defs/citationId"
        },
        "note": {
          "type": "string"
        },
        "shibafan": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "herb": {
                "type": "string"
              },
              "opposes": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "herb",
              "opposes"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "shijiuwei": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              }
            },
            "required": [
              "a",
              "b"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "citation",
        "note",
        "shibafan",
        "shijiuwei"
      ],
      "type": "object"
    },
    "pregnancy_acupoints": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "applies_to": {
            "additionalProperties": false,
            "properties": {
              "always": {
                "type": "boolean"
              },
              "condition": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "constitution": {
                "items": {
                  "$ref": "#/$defs/constitutionId"
                },
                "type": "array"
              },
              "medication_class": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "population": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "state": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [],
            "type": "object"
          },
          "citation": {
            "$ref": "#/$defs/citationId"
          },
          "condition": {
            "type": "string"
          },
          "id": {
            "$ref": "#/$defs/ruleId"
          },
          "message": {
            "$ref": "#/$defs/bilingualNamed"
          },
          "note": {
            "type": "string"
          },
          "reference": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "age": {
                      "type": "string"
                    },
                    "fraction_of_adult": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "age",
                    "fraction_of_adult"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            ]
          },
          "severity": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "target": {
            "additionalProperties": false,
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "acupoints": {},
              "conflict": {},
              "effect": {},
              "flavor_share_over": {},
              "food_pregnancy_caution": {},
              "formula_tier": {},
              "herb_in_user_allergy_list": {},
              "herb_interaction": {},
              "herb_pairs": {},
              "herb_pregnancy": {},
              "output_level_max": {}
            },
            "type": "object"
          }
        },
        "required": [
          "applies_to",
          "id",
          "message",
          "severity",
          "target"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "_meta",
    "incompatibilities",
    "pregnancy_acupoints",
    "rules"
  ],
  "title": "Safety rules",
  "type": "object"
}
