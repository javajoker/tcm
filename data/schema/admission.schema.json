{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "enStatus": {
      "enum": [
        "machine-draft",
        "reviewed"
      ]
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "moduleId": {
      "enum": [
        "sleep",
        "fatigue",
        "digestion",
        "cold-heat-sweat",
        "head-body-pain",
        "mood-stress",
        "womens-cycle",
        "early-external"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|yingwei\\.(衛|營|開闔)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "questionId": {
      "pattern": "^Q_[A-Z_]+$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "type": "string"
        },
        "schema": {
          "type": "integer"
        },
        "waivers": {
          "type": "integer"
        }
      },
      "required": [
        "description",
        "schema",
        "waivers"
      ],
      "type": "object"
    },
    "margin_exceptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "patterns": {
            "items": {
              "pattern": "^[A-Z]{2}[0-9]{1,2}$",
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "patterns",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "needs_exam": {
      "items": {
        "pattern": "^[A-Z]{2}[0-9]{1,2}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "no_release_formula": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "pattern": "^[A-Z]{2}[0-9]{1,2}$",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "pattern",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "original": {
      "items": {
        "pattern": "^[A-Z]{2}[0-9]{1,2}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "red_flag_boundary": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "flags": {
            "items": {
              "pattern": "^RF_[A-Z0-9_]+$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "pattern": {
            "pattern": "^[A-Z]{2}[0-9]{1,2}$",
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "flags",
          "pattern",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "textbook_sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "type": "string"
          },
          "path": {
            "pattern": "^reference/.+",
            "type": "string"
          },
          "pattern": {
            "pattern": "^[A-Z]{2}[0-9]{1,2}$",
            "type": "string"
          }
        },
        "required": [
          "note",
          "path",
          "pattern"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "waivers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "patterns": {
            "items": {
              "pattern": "^[A-Z]{2}[0-9]{1,2}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "row": {
            "pattern": "^A[0-9]{1,2}$",
            "type": "string"
          }
        },
        "required": [
          "patterns",
          "reason",
          "row"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "_meta",
    "margin_exceptions",
    "needs_exam",
    "no_release_formula",
    "original",
    "red_flag_boundary",
    "textbook_sources",
    "waivers"
  ],
  "title": "Admission records of the pattern library",
  "type": "object"
}
