{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "enStatus": {
      "enum": [
        "machine-draft",
        "reviewed"
      ]
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "moduleId": {
      "enum": [
        "sleep",
        "fatigue",
        "digestion",
        "cold-heat-sweat",
        "head-body-pain",
        "mood-stress",
        "womens-cycle",
        "early-external"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "questionId": {
      "pattern": "^Q_[A-Z_]+$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "corpus_categories": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "books": {
                "type": "integer"
              },
              "drawn_on": {
                "type": "integer"
              },
              "registered": {
                "type": "integer"
              }
            },
            "required": [
              "books",
              "drawn_on",
              "registered"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "count": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "domains": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string"
              },
              "zh-Hant": {
                "type": "string"
              }
            },
            "required": [
              "en",
              "zh-Hant"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "drawn_on": {
          "type": "integer"
        },
        "schema": {
          "type": "integer"
        },
        "status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "unresolved": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "corpus_categories",
        "count",
        "description",
        "domains",
        "drawn_on",
        "schema",
        "status_counts",
        "unresolved"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "corpus": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "exists": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string"
                },
                "repo": {
                  "enum": [
                    "TCM-Ancient-Books",
                    "TCM-Library"
                  ]
                }
              },
              "required": [
                "exists",
                "path",
                "repo"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "domains": {
            "items": {
              "enum": [
                "theory",
                "diagnosis",
                "pattern-systems",
                "materia-medica",
                "formulas",
                "treatment",
                "prevention",
                "acupuncture",
                "terminology"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "drawn_on": {
            "type": "boolean"
          },
          "edition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "author": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "dynasty": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "year": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "author",
                  "category",
                  "dynasty",
                  "year"
                ],
                "type": "object"
              }
            ]
          },
          "era": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "classic",
              "pharmacopoeia",
              "textbook",
              "standard",
              "compilation",
              "website"
            ]
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "quotations": {
            "type": "integer"
          },
          "references": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "status": {
            "enum": [
              "in-corpus",
              "not-in-corpus",
              "bibliography"
            ]
          },
          "title": {
            "type": "string"
          },
          "use": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "author",
          "corpus",
          "domains",
          "drawn_on",
          "edition",
          "era",
          "id",
          "kind",
          "names",
          "quotations",
          "references",
          "status",
          "title",
          "use"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "_meta",
    "items"
  ],
  "title": "Sources registry",
  "type": "object"
}
