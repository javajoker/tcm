          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
