        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "enStatus": {
      "enum": [
        "machine-draft",
        "reviewed"
      ]
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
