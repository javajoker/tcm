{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "composition_status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "count": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "proportion_note": {
          "type": "string"
        },
        "role_weight_basis": {
          "items": {
            "$ref": "#/$defs/citationId"
          },
          "type": "array"
        },
        "role_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "schema": {
          "type": "integer"
        },
        "tier_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "tier_rule": {
          "type": "string"
        }
      },
      "required": [
        "composition_status_counts",
        "count",
        "description",
        "proportion_note",
        "role_weight_basis",
        "role_weights",
        "schema",
        "tier_counts",
        "tier_rule"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cautions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "classical_amounts": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "amount": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "processing": {
                      "type": "string"
                    },
                    "unit": {
                      "enum": [
                        "两",
                        "个",
                        "枚",
                        "升",
                        "合",
                        "斤"
                      ]
                    }
                  },
                  "required": [
                    "amount",
                    "name",
                    "processing",
                    "unit"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            ]
          },
          "composition": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "classical_amount": {
                  "additionalProperties": false,
                  "properties": {
                    "processing": {
                      "type": "string"
                    },
                    "unit": {
                      "enum": [
                        "两",
                        "个",
                        "枚",
                        "升",
                        "合",
                        "斤"
                      ]
                    },
                    "value": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "processing",
                    "unit",
                    "value"
                  ],
                  "type": "object"
                },
                "effective_weight": {
                  "type": "number"
                },
                "herb": {
                  "$ref": "#/$defs/herbId"
                },
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "proportion": {
                  "type": "number"
                },
                "role": {
                  "enum": [
                    "君",
                    "臣",
                    "佐",
                    "使"
                  ]
                },
                "role_weight": {
                  "type": "number"
                },
                "typical_g": {
                  "type": "number"
                }
              },
              "required": [
                "effective_weight",
                "herb",
                "name",
                "note",
                "proportion",
                "role",
                "role_weight",
                "typical_g"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "core_indications": {
            "items": {
              "$ref": "#/$defs/symptomId"
            },
            "minItems": 1,
            "type": "array"
          },
          "flavor_profile": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "id": {
            "$ref": "#/$defs/formulaId"
          },
          "interactions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kb_commit": {
            "type": "string"
          },
          "modifications": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "add": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "herb": {
                        "$ref": "#/$defs/herbId"
                      },
                      "name": {
                        "type": "string"
                      },
                      "role": {
                        "enum": [
                          "君",
                          "臣",
                          "佐",
                          "使"
                        ]
                      },
                      "typical_g": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "herb",
                      "name",
                      "role",
                      "typical_g"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "id": {
                  "pattern": "^M_[A-Z0-9_]+$",
                  "type": "string"
                },
                "remove": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "herb": {
                        "$ref": "#/$defs/herbId"
                      },
                      "name": {
                        "type": "string"
                      },
                      "role": {
                        "enum": [
                          "君",
                          "臣",
                          "佐",
                          "使"
                        ]
                      },
                      "typical_g": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "herb",
                      "name",
                      "role",
                      "typical_g"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "result_name": {
                  "type": "string"
                },
                "source": {
                  "additionalProperties": false,
                  "properties": {
                    "book": {
                      "type": "string"
                    },
                    "verification": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "book",
                    "verification"
                  ],
                  "type": "object"
                },
                "status": {
                  "type": "string"
                },
                "when_symptoms": {
                  "items": {
                    "$ref": "#/$defs/symptomId"
                  },
                  "type": "array"
                }
              },
              "required": [
                "add",
                "id",
                "remove",
                "result_name",
                "source",
                "status",
                "when_symptoms"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "mvp": {
            "type": "boolean"
          },
          "name": {
            "$ref": "#/$defs/bilingualNamed"
          },
          "panel_burden": {
            "$ref": "#/$defs/panelMap"
          },
          "panel_effect": {
            "$ref": "#/$defs/panelMap"
          },
          "patterns": {
            "items": {
              "$ref": "#/$defs/patternId"
            },
            "type": "array"
          },
          "pregnancy": {
            "enum": [
              "ok",
              "ok-unreviewed",
              "caution",
              "avoid"
            ]
          },
          "principle": {
            "type": "string"
          },
          "rationale_citations": {
            "items": {
              "$ref": "#/$defs/citationId"
            },
            "type": "array"
          },
          "rationale_zh": {
            "type": "string"
          },
          "school": {
            "enum": [
              "經方",
              "時方"
            ]
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "book": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "repo_path": {
                "type": "string"
              }
            },
            "required": [
              "book",
              "ref"
            ],
            "type": "object"
          },
          "status": {
            "$ref": "#/$defs/reviewStatus"
          },
          "tier": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "tier_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "verification": {
            "additionalProperties": false,
            "properties": {
              "classical": {
                "additionalProperties": false,
                "properties": {
                  "anchor": {
                    "type": "string"
                  },
                  "matched_in_formula": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "not_in_formula": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "parsed": {
                    "type": "integer"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "anchor",
                  "matched_in_formula",
                  "not_in_formula",
                  "note",
                  "parsed",
                  "path"
                ],
                "type": "object"
              },
              "composition_check": {
                "additionalProperties": false,
                "properties": {
                  "book_path": {
                    "type": "string"
                  },
                  "found": {
                    "type": "integer"
                  },
                  "missing": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "note": {
                    "type": "string"
                  },
                  "occurrences": {
                    "type": "integer"
                  },
                  "total": {
                    "type": "integer"
                  }
                },
                "required": [
                  "book_path",
                  "found",
                  "missing",
                  "occurrences",
                  "total"
                ],
                "type": "object"
              },
              "composition_status": {
                "enum": [
                  "verified-against-classical-text",
                  "verified-against-source-book",
                  "partially-verified"
                ]
              },
              "proportion_basis": {
                "type": "string"
              },
              "role_status": {
                "type": "string"
              },
              "source_note": {
                "type": "string"
              }
            },
            "required": [
              "composition_status",
              "proportion_basis",
              "role_status"
            ],
            "type": "object"
          }
        },
        "required": [
          "cautions",
          "classical_amounts",
          "composition",
          "core_indications",
          "flavor_profile",
          "id",
          "interactions",
          "kb_commit",
          "modifications",
          "mvp",
          "name",
          "panel_burden",
          "panel_effect",
          "patterns",
          "pregnancy",
          "principle",
          "rationale_citations",
          "rationale_zh",
          "school",
          "source",
          "status",
          "tier",
          "tier_reasons",
          "verification"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "_meta",
    "items"
  ],
  "title": "Formulas",
  "type": "object"
}
