{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "moduleId": {
      "enum": [
        "sleep",
        "fatigue",
        "digestion",
        "cold-heat-sweat",
        "head-body-pain",
        "mood-stress",
        "womens-cycle",
        "early-external"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "questionId": {
      "pattern": "^Q_[A-Z_]+$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "type": "string"
        },
        "schema": {
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        }
      },
      "required": [
        "description",
        "schema",
        "status"
      ],
      "type": "object"
    },
    "acupoints": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "type": "string"
          },
          "cautions": {
            "items": {
              "$ref": "#/$defs/bilingualNamed"
            },
            "type": "array"
          },
          "code": {
            "type": "string"
          },
          "location": {
            "$ref": "#/$defs/bilingualNamed"
          },
          "meridian": {
            "type": "string"
          },
          "pregnancy_avoid": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/$defs/reviewStatus"
          }
        },
        "required": [
          "basis",
          "cautions",
          "code",
          "location",
          "meridian",
          "pregnancy_avoid",
          "status"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "acupressure": {
      "additionalProperties": false,
      "properties": {
        "cautions": {
          "items": {
            "$ref": "#/$defs/bilingualNamed"
          },
          "type": "array"
        },
        "how": {
          "$ref": "#/$defs/bilingualNamed"
        }
      },
      "required": [
        "cautions",
        "how"
      ],
      "type": "object"
    },
    "food_pregnancy_caution": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "foods": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "enum": [
              "pharmacopoeia",
              "textbook"
            ]
          },
          "cautions": {
            "items": {
              "$ref": "#/$defs/bilingualNamed"
            },
            "type": "array"
          },
          "citations": {
            "items": {
              "$ref": "#/$defs/citationId"
            },
            "minItems": 1,
            "type": "array"
          },
          "flavors": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "functions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "herb": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/herbId"
              }
            ]
          },
          "nature": {
            "type": "string"
          },
          "pregnancy_caution": {
            "type": "boolean"
          },
          "rationale": {
            "$ref": "#/$defs/bilingualNamed"
          },
          "status": {
            "$ref": "#/$defs/reviewStatus"
          }
        },
        "required": [
          "basis",
          "cautions",
          "citations",
          "flavors",
          "functions",
          "herb",
          "nature",
          "pregnancy_caution",
          "rationale",
          "status"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "general": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "items": {
            "$ref": "#/$defs/citationId"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "text"
      ],
      "type": "object"
    },
    "lifestyle": {
      "additionalProperties": {
        "$ref": "#/$defs/bilingualNamed"
      },
      "minProperties": 1,
      "type": "object"
    }
  },
  "required": [
    "_meta",
    "acupoints",
    "acupressure",
    "food_pregnancy_caution",
    "foods",
    "general",
    "lifestyle"
  ],
  "title": "Treatment guidance",
  "type": "object"
}
