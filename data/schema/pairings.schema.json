{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "enStatus": {
      "enum": [
        "machine-draft",
        "reviewed"
      ]
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "moduleId": {
      "enum": [
        "sleep",
        "fatigue",
        "digestion",
        "cold-heat-sweat",
        "head-body-pain",
        "mood-stress",
        "womens-cycle",
        "early-external"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "questionId": {
      "pattern": "^Q_[A-Z_]+$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/citationId"
          },
          "type": "array"
        },
        "count": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "entries_read": {
          "type": "integer"
        },
        "names_not_in_the_knowledge_base": {
          "type": "integer"
        },
        "schema": {
          "type": "integer"
        },
        "type_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "types": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "citations",
        "count",
        "description",
        "entries_read",
        "schema",
        "type_counts",
        "types"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "herb": {
            "$ref": "#/$defs/herbId"
          },
          "id": {
            "pattern": "^[a-z0-9]+\\.(xu|shi|wei|wu|fan)\\.[a-z0-9]+$",
            "type": "string"
          },
          "other": {
            "$ref": "#/$defs/herbId"
          },
          "says": {
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "book": {
                "type": "string"
              },
              "chapter": {
                "type": "string"
              },
              "entry_zh_hans": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "book",
              "chapter"
            ],
            "type": "object"
          },
          "status": {
            "enum": [
              "derived",
              "curated-draft",
              "reviewed"
            ]
          },
          "type": {
            "enum": [
              "相須",
              "相使",
              "相畏",
              "相惡",
              "相反"
            ]
          }
        },
        "required": [
          "herb",
          "id",
          "other",
          "says",
          "source",
          "status",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "_meta",
    "items"
  ],
  "title": "七情 pairings between herbs",
  "type": "object"
}
