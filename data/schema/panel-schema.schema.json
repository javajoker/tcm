{
  "$defs": {
    "bilingual": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "bilingualNamed": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "zh-Hant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh-Hant"
      ],
      "type": "object"
    },
    "citationId": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "constitutionId": {
      "pattern": "^C_[A-Z]+$",
      "type": "string"
    },
    "element": {
      "enum": [
        "木",
        "火",
        "土",
        "金",
        "水"
      ]
    },
    "elementId": {
      "pattern": "^PE_.+$",
      "type": "string"
    },
    "enStatus": {
      "enum": [
        "machine-draft",
        "reviewed"
      ]
    },
    "evil": {
      "enum": [
        "風",
        "寒",
        "暑",
        "濕",
        "燥",
        "火"
      ]
    },
    "formulaId": {
      "pattern": "^F_[A-Z0-9_]+$",
      "type": "string"
    },
    "herbId": {
      "pattern": "^herb-[a-z0-9_]+$",
      "type": "string"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "moduleId": {
      "enum": [
        "sleep",
        "fatigue",
        "digestion",
        "cold-heat-sweat",
        "head-body-pain",
        "mood-stress",
        "womens-cycle",
        "early-external"
      ]
    },
    "notice": {
      "enum": [
        "none",
        "inline",
        "blocking_ack"
      ]
    },
    "panelDim": {
      "pattern": "^((肝|心|脾|肺|腎|膽|小腸|胃|大腸|膀胱)\\.(qi|blood|yin|yang|stasis)|liuxie\\.(風|寒|暑|濕|燥|火)|product\\.(痰|飲|瘀|食積)|yingwei\\.(衛|營|開闔)|bagang\\.exterior)$",
      "type": "string"
    },
    "panelMap": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/panelDim"
      },
      "type": "object"
    },
    "patternId": {
      "pattern": "^(EX|SP|LV|HT|LG|KD|QB)[0-9]$",
      "type": "string"
    },
    "questionId": {
      "pattern": "^Q_[A-Z_]+$",
      "type": "string"
    },
    "redFlagId": {
      "pattern": "^RF_[ABC]_[A-Z_]+$",
      "type": "string"
    },
    "reviewStatus": {
      "enum": [
        "derived",
        "curated-draft",
        "draft",
        "reviewed"
      ]
    },
    "ruleId": {
      "pattern": "^R_[A-Z_]+$",
      "type": "string"
    },
    "symptomId": {
      "pattern": "^[STP]_[A-Z0-9_]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "type": "string"
        },
        "schema": {
          "type": "integer"
        }
      },
      "required": [
        "description",
        "schema"
      ],
      "type": "object"
    },
    "channels": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 5,
      "type": "object"
    },
    "derived": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "exterior_locations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "liuxie": {
      "items": {
        "$ref": "#/$defs/evil"
      },
      "minItems": 6,
      "type": "array"
    },
    "location_organs": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "nature_projection": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "type": "object"
    },
    "offsets": {
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        }
      },
      "required": [
        "primary",
        "secondary"
      ],
      "type": "object"
    },
    "organs": {
      "additionalProperties": false,
      "properties": {
        "element_of": {
          "additionalProperties": {
            "$ref": "#/$defs/element"
          },
          "type": "object"
        },
        "fu": {
          "items": {
            "type": "string"
          },
          "minItems": 5,
          "type": "array"
        },
        "zang": {
          "items": {
            "type": "string"
          },
          "minItems": 5,
          "type": "array"
        }
      },
      "required": [
        "element_of",
        "fu",
        "zang"
      ],
      "type": "object"
    },
    "products": {
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "type": "array"
    },
    "yingwei": {
      "additionalProperties": false,
      "properties": {
        "coupling": {
          "additionalProperties": false,
          "properties": {
            "sources": {
              "additionalProperties": {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              "type": "object"
            },
            "strength": {
              "type": "number"
            }
          },
          "required": [
            "sources",
            "strength"
          ],
          "type": "object"
        },
        "dimensions": {
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "type": "array"
        },
        "scale": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "coupling",
        "dimensions",
        "scale"
      ],
      "type": "object"
    }
  },
  "required": [
    "_meta",
    "channels",
    "derived",
    "exterior_locations",
    "liuxie",
    "location_organs",
    "nature_projection",
    "offsets",
    "organs",
    "products",
    "yingwei"
  ],
  "title": "Panel schema",
  "type": "object"
}
